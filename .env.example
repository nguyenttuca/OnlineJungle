# ==============================================
# API_OJ - Online Judge Configuration
# ==============================================

# Server
PORT=8080
ENVIRONMENT=development    # development | production

# Database
DATABASE_URL=postgres://user:password@localhost:5432/oj?sslmode=disable

# Session
SESSION_KEY=change-me-to-a-random-64-char-string

# Dispatcher
MAX_WORKERS=10             # Số worker goroutines cho judge dispatcher

# Logging  
LOG_LEVEL=info             # debug | info | warn | error
